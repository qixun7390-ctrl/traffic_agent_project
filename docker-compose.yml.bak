version: "3.8"

services:
  #postgres database
  postgres:
    image: pgvector/pgvector:pg16
    container_name: traffic_postgres

    environment:
      POSTGRES_DB: traffic_project
      POSTGRES_USER: traffic_agent
      POSTGRES_PASSWORD: password123

    ports:
      - "5432:5432"

    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./scripts/init_db.sql:/docker-entrypoint-initdb.d/init_db.sql
    healthcheck:
      test: ["CMD-SHELL","pg_isready -U traffic_agent -d traffic_project"]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  #首次启动时为空，Docker会自动从
  postgres_data: