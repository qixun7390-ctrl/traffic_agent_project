# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment files - never commit real secrets
.env
.env.*
!.env.example
!.env.docker.example

# User uploaded files / runtime storage
storage/
uploads/
logs/
*.log

# Local business data, keep private for now
datas/
multi_work_area/
# Local/manual test scripts may contain tokens and absolute paths
tests/*
!tests/conftest.py
!tests/test_unit/
!tests/test_unit/**
!tests/test_api/
!tests/test_api/**
tests/**/__pycache__/
tests/**/*.py[cod]
test/
test
new_tests/
tests/
# IDE / OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Temporary / backup files
*.bak
docker-compose.yml.bak
